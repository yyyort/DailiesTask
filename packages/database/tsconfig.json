{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "/",
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node"
    ],
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "drizzle.*.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}